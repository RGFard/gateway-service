# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT (required for protected endpoints)
JWT_SECRET=dev-secret-change-me

# API keys — comma-separated allowlist for x-api-key header
API_KEYS=dev-api-key-change-me

# n8n workflow webhook
N8N_WEBHOOK_URL=https://datanexuscore.app.n8n.cloud/webhook-test/ai/webhook/shipment/
N8N_WEBHOOK_TIMEOUT_MS=30000

# Rate limiting (global)
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

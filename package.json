{
  "name": "gateway-service",
  "version": "1.0.0",
  "description": "Gateway Service \u2014 Fastify API gateway",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "token": "tsx --env-file=.env scripts/generate-token.ts",
    "test": "tsx --test test/correlation-envelope.test.ts test/workflow-reply.test.ts test/idempotency-store.test.ts"
  },
  "keywords": [
    "fastify",
    "gateway",
    "api"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/env": "^5.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
